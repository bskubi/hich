nextflow_pipeline {

    name "Test Workflow main.nf"
    script "main.nf"

    test("Very simple fastq to endpoint pipeline run") {


        when {
            params {
                manifest = "$projectDir/tests/assets/manifests/basic_manifest.yaml"
            }
        }

        then {
            assert workflow.success
        }

    }

    test ("Pipeline end to end stub run") {
        options "-stub-run"
        when {
            params {
                manifest = "$projectDir/tests/assets/manifests/test_skip.yaml"
            }
        }

        then {
            assert workflow.success
            assert workflow.trace.tasks().size() == 18
        }
    }

}
