nextflow_workflow {

    name "Test Workflow getSources"
    script "modules/subworkflows/getSources.nf"
    workflow "getSources"

    test("Main getSources test") {

        when {
            workflow {
                """
                input[0] = channel.fromList([
                    [id: '11', source_ids: ['111', '112']],
                    [id: '12', source_ids: ['121', '122']],
                    [id: 'target_has_no_source', source_ids: []],
                    [id: 'target_has_duplicate_source', source_ids: ['111', '111', '112']],
                    [id: 'single_source_merge', source_ids: ['111']],
                    [id: '1', source_ids: ['111', '112', '121', '122']],
                    
                ])
                input[1] = channel.fromList([
                    ['111', '111.pairs'],
                    ['112', '112.pairs'],
                    ['121', '121.pairs'],
                    ['122', '122.pairs']
                ])
                """
            }
        }

        then {
            assert workflow.success
            def expected = [
                ['11', ['111.pairs', '112.pairs']],
                ['12', ['121.pairs', '122.pairs']],
                ['1', ['111.pairs', '112.pairs', '121.pairs', '122.pairs']],
                ['target_has_duplicate_source', ['111.pairs', '111.pairs', '112.pairs']],
                ['single_source_merge', ['111.pairs']]
            ].collect{ [it[0], it[1].sort()] }

            assertContainsInAnyOrder(
                workflow.out.ch_targets,
                expected
            )
            assert workflow.out.ch_targets.size() == 5

            def ids = workflow.out.ch_targets.collect{it[0]}
            assert !ids.contains('target_has_no_source')
        }
    }

    test("Merge missing required sources") {
        when {
            workflow {
                """
                input[0] = channel.fromList([
                    [id: '11', source_ids: ['111', '112']]
                ])
                input[1] = channel.fromList([
                    ['111', '111.pairs']
                ])
                """
            }
        }
        then {
            assert workflow.failed
        }

    }

    test("Test getPairsMerge on empty entrypoint channel") {
        when {
            workflow {
                """
                input[0] = channel.of()
                input[1] = channel.fromList([
                    ['1', '1.pairs'],
                    ['2', '2.pairs'],
                ])
                """
            }
        }
        then {
            assert workflow.success
            assert workflow.out.ch_targets.isEmpty()
        }
    }

    test("Test getPairsMerge on empty process output channel") {
        when {
            workflow {
                """
                input[0] = channel.fromList([
                    [id: '1', source_ids: ['11', '12']]
                ])
                input[1] = channel.of()
                """
            }
        }
        then {
            assert workflow.failed
        }
    }

    test("Test getPairsMerge on empty channels") {
        when {
            workflow {
                """
                input[0] = channel.of()
                input[1] = channel.of()
                """
            }
        }
        then {
            assert workflow.success
            assert workflow.out.ch_targets.isEmpty()
        }
    }

}
